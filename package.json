{
  "name": "try-ts",
  "version": "0.1.0",
  "type": "module",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "vendor": "bun run scripts/vendor-try.ts",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "test": "bun test",
    "test:integration": "TRY_TS_INTEGRATION=1 bun test --timeout 120000",
    "test:integration:ns": "scripts/private-mounts.sh env TRY_TS_INTEGRATION=1 bun test --timeout 120000",
    "typecheck": "bunx tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
